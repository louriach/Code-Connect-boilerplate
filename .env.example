# Rename this file to .env and fill in your values.
# Never commit .env to version control — it contains your personal access token.

# Your Figma personal access token.
# Generate one in Figma → Settings → Personal access tokens
# Required scopes: Code Connect = Write, File content = Read
FIGMA_ACCESS_TOKEN=

# Your Figma file key — the random string in your Figma file's URL.
# e.g. https://www.figma.com/design/aBcDeFgHiJkLmNoP/... → aBcDeFgHiJkLmNoP
FIGMA_FILE_KEY=
